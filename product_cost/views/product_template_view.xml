<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
             <xpath expr="//page[@name='inventory']" position="after">
                <page name="uso_maquinas" string="Uso de maquinas" >
                    <group>
                        <field name="calculation_use_machinery"/>
                        <field name="use_machinery"/>
                    </group>

                    <group string="Calculo de precio por uso"  invisible="not use_machinery">
                        <group>
                            <field name="product_cost_id"/>
                            <field name="useful_life"/>
                            <button name="accion_calcular_precio" type="object" string="Calcular precio" class="oe_highlight"/>
                        </group>
                        <group>
                        </group>

                    </group>
                    <group string="Uso de servicios por maquinaria"  invisible="not calculation_use_machinery" >
                         <group>
                             <field name="products_price_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                </tree>
                            </field>
                             <button name="action_sumar_precios" type="object" string="Sumar Precios" class="oe_highlight"/>

                        </group>
                        <group>
                        </group>


                    </group>

                </page>

            </xpath>
        </field>
    </record>
</odoo>
