<odoo>
    <!-- Definición de la vista tree -->
    <record id="view_product_cost_tree" model="ir.ui.view">
        <field name="name">Costos de productos</field>
        <field name="model">product.cost</field>
        <field name="arch" type="xml">
            <tree string="Costos de productos">
                <field name="name"/>
                <field name="product_price" string = "Precio del producto"/>
                <field name="product_total_cost" string = "Costo total del producto"/>
                <field name="stage" string = "Estado"/>
            </tree>
        </field>
    </record>

    <!-- Definición de la vista Form -->
    <record id="view_product_cost_form" model="ir.ui.view">
        <field name="name">Costos.productos</field>
        <field name="model">product.cost</field>
        <field name="arch" type="xml">
            <form string="Costos de productos">
                <header>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_product"
                            class="oe_stat_button" icon="fa-cube" string="Producto"
                            groups="product_cost.group_product_cost"/>
                    </div>

                  <button name="action_create_product" type="object" string="Crear Producto"
                            class="oe_highlight"
                            groups="product_cost.group_product_cost"
                            invisible="product_smart_id"/>
                    <field name="stage" widget="statusbar" options="{'clickable': True}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_smart_id"/>
                    </group>
                    <group>
                        <group string="Costo">
                            <field name="product_total_cost" string = "Costo total del producto:"/>
                        </group>

                    </group>
                    <group>
                        <group>
                        </group>
                        <group string="Precio">
                             <field name="gain_factor" string = "Factor de ganancia:"/>
                             <field name="product_price" string = "Precio del producto:"/>
                        </group>
                    </group>
                     <group string="Costo de Materiales">
                        <!-- Aqui va la tabla-->
                         <field name="material_cost_ids"/>
                    </group>
                    <group>
                        <group>
                        </group>

                        <group>
                            <field name="total_line_products" string="Total linea de productos"/>
                        </group>
                    </group>
                    <group string="Costo de Servicio por maquinarias y herramientas">
                        <field name="material_tools_cost_ids" string="Total Costo de materiales"/>
                    </group>
                    <group>
                        <group>

                        </group>
                        <group>
                             <field name="total_service_machines_tools" string = "Total de servicios y herramientas"/>

                        </group>
                    </group>
                    <group string="Costo de Corte">
                        <!-- Aqui va la tabla-->
                        <field name="cutting_cost_ids"/>
                    </group>
                    <group>
                        <group>

                        </group>
                        <group>
                             <field name="total_service_cort" string="Total Costo de Corte"/>
                        </group>
                    </group>
                    <group string="Costo de Operación">
                        <!-- Aqui va la tabla-->
                        <field name="operating_cost_ids"/>
                    </group>
                     <group>
                        <group>

                        </group>
                        <group>
                            <field name="total_operating_cost" string="Total Costo de Operación"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción asociada al menú (mostrar registros de un modelo) -->
    <record id="action_productcost" model="ir.actions.act_window">
        <field name="name">Costos de productos</field>
        <field name="res_model">product.cost</field>  <!-- Cambia 'mi.modelo' por el modelo de tu aplicación -->
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menú principal -->
    <menuitem id="menu_productcost" name="Costos de productos" sequence="10"/>

    <!-- Submenú -->
    <menuitem id="menu_productcost_submenu" name="Costos de productos" parent="menu_productcost" sequence="1"/>

    <!-- Vínculo de la acción con el menú -->
    <menuitem id="menu_productcost_action" name="Costos de productos" parent="menu_productcost" action="action_productcost" sequence="2"/>
</odoo>
