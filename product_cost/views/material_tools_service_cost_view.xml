<odoo>
    <!-- Definición de la vista tree -->
    <record id="view_material_tools_cost_tree" model="ir.ui.view">
        <field name="name">material.tools.cost</field>
        <field name="model">material.tools.cost</field>
        <field name="arch" type="xml">
            <tree string="Servicio de materialezz" editable="bottom" multi_edit="1" open_form_view="true">
                <field name="product_id"/>
                <field name="sales_price"/>
            </tree>
        </field>
    </record>


     <!-- Definición de la vista Form -->
    <record id="view_material_tools_cost_form" model="ir.ui.view">
        <field name="name">material.tools.cost</field>
        <field name="model">material.tools.cost</field>  <!-- El nombre del modelo -->
        <field name="arch" type="xml">
            <form string="Servicio de materiales">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="sales_price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Acción asociada al menú (mostrar registros de un modelo) -->
    <record id="action_material_tools_cost" model="ir.actions.act_window">
        <field name="name">Costo de servicios de maquinas y herramientas</field>
        <field name="res_model">material.tools.cost</field>  <!-- Cambia 'mi.modelo' por el modelo de tu aplicación -->
        <field name="view_mode">tree,form</field>
    </record>



    <!-- Submenú -->
    <menuitem id="menu_materialcost_submenu" name="Configuración" parent="menu_productcost" sequence="2"/>


    <!-- Vínculo de la acción con el menú -->
    <menuitem id="menu_material_tools_cost_action" name="Costo de servicios de maquinas y herramientas" parent="menu_materialcost_submenu" action="action_material_tools_cost" sequence="4"/>
</odoo>